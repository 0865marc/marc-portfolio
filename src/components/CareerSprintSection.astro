---
import { challenge } from '../data/challenge'
import { progressHref, roadmapHref } from '../lib/challengeRoutes'

const dateFormatter = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
const formatDate = (date: string) => dateFormatter.format(new Date(`${date}T12:00:00Z`))
const plannedObjectives = [
  {
    title: 'Generative AI Engineering with LLMs Specialization',
    type: 'Objetivo formativo · IBM',
    description: 'Parte prevista del plan para recorrer modelos generativos, RAG, agentes, LangChain, fine-tuning y ejercicios aplicados.',
    resources: [
      { label: 'Ver plan de especialización', href: 'https://www.coursera.org/specializations/generative-ai-engineering-with-llms' },
    ],
  },
  {
    title: 'AWS Certified Solutions Architect – Associate',
    type: 'Objetivo formativo · AWS',
    description: 'Parte prevista del plan para preparar contenidos de arquitectura AWS: seguridad, resiliencia, escalabilidad, redes, cómputo, almacenamiento y bases de datos.',
    resources: [
      { label: 'Ver plan de aprendizaje', href: 'https://skillbuilder.aws/learning-plan/X34U4HHQ76/aws-solutions-architect-advanced-learning-plan-includes-labs/88TUXWD6NV' },
      { label: 'Ver plan de preparación', href: 'https://skillbuilder.aws/learning-plan/UYRXS2DF85/exam-prep-plan-aws-certified-solutions-architect--associate-saac03--english/U991QUF9C3' },
      { label: 'Consultar información del examen', href: 'https://aws.amazon.com/certification/certified-solutions-architect-associate/' },
    ],
  },
  {
    title: 'AWS Certified Generative AI Developer – Professional',
    type: 'Objetivo formativo · AWS',
    description: 'Parte prevista del plan para estudiar soluciones de IA generativa en AWS: Amazon Bedrock, RAG, agentes, guardrails, observabilidad y costes.',
    resources: [
      { label: 'Ver plan de aprendizaje', href: 'https://skillbuilder.aws/learning-plan/BGTH16YCTU/aws-generative-ai-developer-advanced-learning-plan-includes-labs/ZDN46CX881' },
      { label: 'Ver plan de preparación', href: 'https://skillbuilder.aws/learning-plan/9VXVGYT38G/exam-prep-plan-aws-certified-generative-ai-developer--professional-aipc01--english/4SCMN2659K' },
      { label: 'Consultar información del examen', href: 'https://aws.amazon.com/certification/certified-generative-ai-developer-professional/' },
    ],
  },
] as const
---

<section id="career-sprint" aria-labelledby="career-sprint-title" class="scroll-mt-6 px-5 py-12 sm:px-8 sm:py-16 md:px-10 md:py-20">
  <div id="progress" class="mx-auto max-w-6xl scroll-mt-6">
    <div class="rounded-[28px] border border-[#D7E2EA]/20 p-5 sm:p-6 md:p-8">
      <div class="min-w-0">
        <p class="section-kicker">{formatDate(challenge.startDate)} — {formatDate(challenge.endDate)}</p>
        <h2 id="career-sprint-title" data-route-heading tabindex="-1" class="mt-3 text-3xl font-black uppercase leading-tight sm:text-4xl">Reto de 8 semanas</h2>
      </div>

      <p class="mt-6 max-w-4xl font-light leading-relaxed opacity-80">El Career Sprint combina un plan de ocho semanas para reforzar IA generativa y arquitectura cloud con una bitácora separada de actividad realizada y revisada. La agenda no cuenta como trabajo completado: solo la evidencia publicada recoge lo que consta en los datos.</p>
      <nav aria-label="Plan y evidencia del Career Sprint" class="mt-6 flex flex-wrap gap-3">
        <a class="control" href={roadmapHref()}>Ver plan de 8 semanas <span aria-hidden="true">↗</span></a>
        <a class="button-light" href={progressHref()}>Ver evidencia publicada <span aria-hidden="true">↗</span></a>
      </nav>

      <section aria-labelledby="credential-goals-title" class="mt-6">
        <details data-disclosure class="mt-4">
          <summary id="credential-goals-title" class="disclosure-summary" aria-controls="career-sprint-objectives-panel">
            <span class="disclosure-title">Objetivos previstos del plan</span>
            <span class="disclosure-label">
              <span data-disclosure-label-closed>Mostrar</span>
              <span data-disclosure-label-open>Ocultar</span>
            </span>
            <span data-disclosure-caret aria-hidden="true">↓</span>
          </summary>
          <div id="career-sprint-objectives-panel" data-disclosure-panel>
            <div class="disclosure-panel-inner">
              <p class="mb-4 max-w-3xl text-sm font-light leading-relaxed opacity-75">Estos recursos forman parte de los objetivos previstos; no acreditan certificaciones ni semanas completadas.</p>
              <ol class="disclosure-list divide-y divide-[#D7E2EA]/20 border-y border-[#D7E2EA]/20">
              {plannedObjectives.map((objective, index) => (
                <li class="min-w-0 py-5 sm:py-6">
                  <article class="grid min-w-0 grid-cols-[2rem_minmax(0,1fr)] gap-x-3 gap-y-4 lg:grid-cols-[2.5rem_minmax(0,1fr)_minmax(15rem,20rem)] lg:items-start lg:gap-x-6">
                    <span class="pt-1 text-xs font-medium uppercase tracking-[.18em] opacity-50" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                    <div class="min-w-0">
                      <p class="section-kicker">{objective.type}</p>
                      <h3 class="mt-3 break-words text-xl font-medium uppercase leading-tight sm:text-2xl">{objective.title}</h3>
                      <p class="mt-3 max-w-2xl break-words font-light leading-relaxed opacity-80">{objective.description}</p>
                    </div>
                    <nav aria-label={`Recursos previstos para ${objective.title}`} class="col-start-2 flex min-w-0 flex-wrap gap-2 lg:col-start-3 lg:flex-col lg:items-stretch">
                      {objective.resources.map(resource => (
                        <a
                          class="control min-h-11 max-w-full justify-between gap-3 break-words"
                          href={resource.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`${resource.label} para ${objective.title}. Abre en una nueva pestaña`}
                        >
                          {resource.label} <span aria-hidden="true">↗</span>
                        </a>
                      ))}
                    </nav>
                  </article>
                </li>
              ))}
              </ol>
            </div>
          </div>
        </details>
      </section>
    </div>
  </div>
</section>
