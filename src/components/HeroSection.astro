---
import { professionalProfile } from '../data/portfolio'

const { identity } = professionalProfile
---

<section aria-labelledby="hero-title" class="px-5 py-8 sm:px-8 md:px-10 md:py-10">
  <div class="mx-auto w-full max-w-6xl">
    <nav data-intro style="--intro-delay: 40ms" aria-label="Navegación principal" class="landing-nav">
      <p class="landing-nav-mark">{identity.displayName} · Portfolio</p>
      <ul class="landing-nav-list">
        <li><a class="landing-nav-link" href="#about">Perfil</a></li>
        <li><a class="landing-nav-link" href="#projects">Proyectos</a></li>
        <li><a class="landing-nav-link" href="#formacion">Formación</a></li>
        <li><a class="landing-nav-link" href="#contact">Contacto</a></li>
      </ul>
    </nav>


    <div class="grid items-end gap-8 pb-10 pt-12 sm:py-16 lg:grid-cols-[minmax(0,1fr)_12rem]">
      <div class="min-w-0">
        <p data-intro style="--intro-delay: 140ms" class="max-w-xl text-base font-light leading-relaxed opacity-80">{identity.headline}</p>
        <h1 id="hero-title" data-route-heading tabindex="-1" data-intro style="--intro-delay: 210ms" class="hero-heading mt-5 break-words text-[clamp(3.5rem,9vw,5.5rem)] font-black uppercase leading-[.98]">
          {identity.displayName}
        </h1>
        <p data-intro style="--intro-delay: 280ms" class="mt-6 max-w-2xl text-lg font-light leading-relaxed sm:text-xl">{identity.summary}</p>
        <div data-intro style="--intro-delay: 340ms" class="mt-9 flex flex-col items-start gap-3 sm:flex-row sm:flex-wrap">
          <a class="button-light" href="#projects">Ver proyectos <span aria-hidden="true">↓</span></a>
          <a class="control" href="#contact">Contactar <span aria-hidden="true">↓</span></a>
        </div>
      </div>

      <aside data-intro style="--intro-delay: 360ms" aria-label="Datos del perfil" class="border-l border-[#D7E2EA]/25 pl-6 lg:mb-2">
        <dl class="grid gap-6">
          <div>
            <dt class="text-xs uppercase tracking-[.22em] opacity-60">Ubicación</dt>
            <dd class="mt-2 text-lg font-light leading-relaxed">{identity.location}</dd>
          </div>
        </dl>
      </aside>
    </div>
  </div>
</section>
