---
import ProjectBrand from './ProjectBrand.astro'
import { professionalProfile } from '../data/portfolio'

const { contacts } = professionalProfile
const currentYear = new Date().getFullYear()
---

<section id="projects" aria-labelledby="projects-title" class="scroll-mt-6 px-5 py-16 sm:px-8 md:px-10 md:py-24">
  <div class="mx-auto max-w-6xl">
    <div data-section-intro class="grid items-end gap-8 xl:grid-cols-[minmax(0,1fr)_minmax(0,25rem)]">
      <div class="min-w-0">
        <p class="section-kicker">Proyectos personales</p>
        <h2 id="projects-title" data-route-heading tabindex="-1" class="mt-4 text-4xl font-black uppercase leading-tight sm:text-5xl">Ideas en práctica</h2>
      </div>
      <p data-section-intro-copy class="min-w-0 text-lg font-light leading-relaxed opacity-80">Dos proyectos propios para resolver necesidades concretas: conectar el aprendizaje y organizar torneos de butifarra.</p>
    </div>

    <div class="mt-8 grid gap-6">
      {professionalProfile.projects.map(project => (
        <article data-project-card aria-labelledby={`${project.id}-title`} class="rounded-[28px] border border-[#D7E2EA]/25 p-5 sm:p-8">
          <div class="grid gap-6 lg:grid-cols-[15rem_minmax(0,1fr)] lg:items-center lg:gap-10">
            <div class="min-w-0">
              <ProjectBrand project={project} />
              <p class="mt-4 text-sm font-light leading-relaxed opacity-75">{project.availability}</p>
            </div>
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs uppercase tracking-[.14em] opacity-75">
                <p>{project.category}</p>
                <span aria-hidden="true">·</span>
                <p>{project.status}</p>
              </div>
              <h3 id={`${project.id}-title`} class="mt-4 text-2xl font-medium leading-tight sm:text-3xl">{project.canonicalName}</h3>
              <p class="mt-2 text-lg font-light leading-relaxed">{project.focus}</p>
              <p class="mt-3 max-w-3xl font-light leading-relaxed opacity-80">{project.teaser}</p>
              <ul aria-label={`Enfoque de ${project.canonicalName}`} class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm font-light opacity-70">
                {project.tags.map(tag => <li class="flex items-baseline gap-2"><span aria-hidden="true">·</span>{tag}</li>)}
              </ul>
              <div class="mt-6 flex flex-wrap gap-3">
                <a class="button-light" href={project.href}>Conocer {project.canonicalName} <span aria-hidden="true">↗</span></a>
                <a class="control" href={project.website} target="_blank" rel="noopener noreferrer" title="Se abre en una nueva pestaña">{project.websiteLabel} <span aria-hidden="true">↗</span></a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<slot name="formation" />

<footer id="contact" aria-labelledby="contact-title" class="scroll-mt-6 px-5 pt-16 sm:px-8 sm:pt-20 md:px-10 md:pt-24">
  <div class="mx-auto max-w-6xl">
    <div data-contact-panel class="rounded-[28px] border border-[#D7E2EA]/25 p-5 sm:p-8 md:p-10">
      <p class="section-kicker">Contacto</p>
      <div class="mt-4 grid min-w-0 gap-6 xl:grid-cols-[minmax(0,1fr)_minmax(0,24rem)] xl:items-end">
        <div class="contact-copy min-w-0">
          <h2 id="contact-title" data-route-heading tabindex="-1" class="hero-heading text-3xl font-black uppercase leading-tight sm:text-4xl">¿Hablamos?</h2>
          <p class="mt-4 max-w-2xl text-lg font-light leading-relaxed opacity-80">¿Buscas un perfil que combine desarrollo de software y coordinación de proyectos? Escríbeme y hablamos de tu equipo y del puesto.</p>
        </div>
        <address class="flex min-w-0 w-full flex-col items-stretch gap-3 not-italic">
          <a class="contact-action button-light w-full max-w-full justify-between gap-4" href={`mailto:${contacts.email}`}>Escríbeme por correo <span aria-hidden="true">↗</span></a>
          <a class="contact-action control w-full max-w-full justify-between gap-4" href={contacts.linkedin} target="_blank" rel="me noopener noreferrer" title="Se abre en una nueva pestaña">Ver perfil en LinkedIn <span aria-hidden="true">↗</span></a>
        </address>
      </div>
    </div>
    <div class="flex flex-col gap-2 py-8 text-xs uppercase tracking-[.16em] opacity-60 sm:flex-row sm:items-center sm:justify-between">
      <p>Marc Teixidó Rosauro · {currentYear}</p>
      <p>Software · Producto · IA aplicada</p>
    </div>
  </div>
</footer>
