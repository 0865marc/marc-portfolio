---
import { professionalProfile } from '../data/portfolio'
---

<section aria-labelledby="journey-title" class="px-5 py-10 sm:px-8 md:px-10">
  <div class="journey-strip mx-auto max-w-[1440px]">
    <div class="journey-strip-intro">
      <p class="section-kicker">Una mirada de extremo a extremo</p>
      <h2 id="journey-title" class="mt-3 text-2xl font-medium uppercase sm:text-3xl">Del problema al sistema</h2>
    </div>
    <ol class="journey-list">
      {professionalProfile.journey.map((step, index) => (
        <li data-reveal data-reveal-delay={String(index * 45)}>
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <strong>{step}</strong>
        </li>
      ))}
    </ol>
  </div>
</section>
