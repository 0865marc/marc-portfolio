---
import type { BlogPost } from '../data/blog'
import type { DailyArticleBlock, DailyProgressEntry } from '../data/challenge'
import ArticleInlineText from './ArticleInlineText.astro'
import DailyArticleBlocks from './DailyArticleBlocks.astro'

interface Props {
  post: BlogPost | DailyProgressEntry
}

const { post } = Astro.props
const isDailyArticle = (article: BlogPost | DailyProgressEntry): article is DailyProgressEntry => 'activityDate' in article
const blockText = (blocks: DailyArticleBlock[]) => blocks.flatMap(block => {
  if (block.type === 'paragraph') return block.text
  if (block.type === 'code') return [block.title ?? '', block.code]
  return block.items
})
const articleText = isDailyArticle(post)
  ? [
      ...blockText(post.introduction),
      ...post.sections.flatMap(section => [section.heading, ...blockText(section.blocks)]),
      ...blockText(post.takeaway),
    ].join(' ')
  : [
      ...post.introduction,
      ...post.sections.flatMap(section => [
        section.heading,
        ...section.paragraphs,
        ...(section.points ?? []),
        ...(section.codeBlocks ?? []).flatMap(block => [block.title ?? '', block.code]),
      ]),
      ...post.takeaway,
    ].join(' ')
const readingMinutes = Math.max(1, Math.ceil(articleText.trim().split(/\s+/).length / 210))
const publicationDate = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })
  .format(new Date(`${post.publishedAt}T12:00:00Z`))
const sectionId = (heading: string, index: number) => `${index + 1}-${heading.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`
const codeCaptionId = (sectionIndex: number, blockIndex: number) => `article-code-caption-${sectionIndex + 1}-${blockIndex + 1}`
const codeCaption = (language: string, title?: string) => title?.trim() || `Código · ${language}`
---

<div data-reading-progress aria-hidden="true" class="reading-progress"><span></span></div>
<div class="article-reading-layout mx-auto max-w-6xl">
  <article data-reading-root class="surface-light mx-auto w-full max-w-3xl rounded-[28px] bg-white px-6 py-10 text-[#0C0C0C] sm:p-10 md:rounded-[40px] md:p-14">
    <header>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs font-medium uppercase tracking-[.18em] text-black/60">
        <p>{post.category}</p>
        <span aria-hidden="true">·</span>
        <p>{publicationDate}</p>
        <span aria-hidden="true">·</span>
        <p>{readingMinutes} min de lectura</p>
      </div>
      <h1 data-route-heading tabindex="-1" class="mt-5 break-words text-[clamp(1.9rem,4.5vw,3.5rem)] font-black uppercase leading-[.94] tracking-[-.02em]">{post.title}</h1>
      <p class="mt-6 text-xl font-light leading-relaxed text-black/70">{post.excerpt}</p>
      <ul class="mt-5 flex flex-wrap gap-2" aria-label="Etiquetas">
        {post.tags.map(tag => <li class="tag-light">{tag}</li>)}
      </ul>
    </header>

    <nav data-article-index aria-label="Contenido del artículo" class="mt-8 rounded-[24px] border border-black/15 p-5 sm:p-6">
      <p class="text-xs font-medium uppercase tracking-[.2em] text-black/55">En este artículo</p>
      <ol class="mt-4 grid gap-2 text-sm sm:grid-cols-2">
        {post.sections.map((section, index) => (
          <li><a class="article-index-link inline-flex min-h-11 items-center gap-2" href={`#${sectionId(section.heading, index)}`}><span class="text-black/60">0{index + 1}</span> {section.heading}</a></li>
        ))}
      </ol>
    </nav>

    <div class="article-prose mt-10">
      {isDailyArticle(post) ? <DailyArticleBlocks blocks={post.introduction} captionScope="introduction" /> : post.introduction.map(paragraph => <p><ArticleInlineText text={paragraph} /></p>)}
      {isDailyArticle(post) ? post.sections.map((section, index) => (
        <section id={sectionId(section.heading, index)} class="scroll-mt-12" data-article-section>
          <p class="article-section-number" aria-hidden="true">0{index + 1}</p>
          <h2 tabindex="-1"><ArticleInlineText text={section.heading} /></h2>
          <DailyArticleBlocks blocks={section.blocks} captionScope={`section-${index + 1}`} />
        </section>
      )) : post.sections.map((section, index) => (
        <section id={sectionId(section.heading, index)} class="scroll-mt-12" data-article-section>
          <p class="article-section-number" aria-hidden="true">0{index + 1}</p>
          <h2 tabindex="-1"><ArticleInlineText text={section.heading} /></h2>
          {section.paragraphs.map(paragraph => <p><ArticleInlineText text={paragraph} /></p>)}
          {section.points && <ul>{section.points.map(point => <li><ArticleInlineText text={point} /></li>)}</ul>}
          {section.codeBlocks?.map((block, blockIndex) => {
            const captionId = codeCaptionId(index, blockIndex)
            return (
              <figure class="article-code" aria-labelledby={captionId}>
                <figcaption id={captionId}>{codeCaption(block.language, block.title)}</figcaption>
                <pre tabindex="0"><code class={`language-${block.language}`}>{block.code}</code></pre>
              </figure>
            )
          })}
        </section>
      ))}
      <aside>
        <p class="mb-3 text-xs font-medium uppercase tracking-[.2em]">Cierre</p>
        {isDailyArticle(post) ? <DailyArticleBlocks blocks={post.takeaway} captionScope="takeaway" /> : post.takeaway.map(paragraph => <p><ArticleInlineText text={paragraph} /></p>)}
      </aside>
    </div>
  </article>

  <aside class="article-index-aside" aria-label="Navegación complementaria del artículo">
    <nav data-floating-index inert aria-hidden="true" aria-label="Índice lateral del artículo" class="article-floating-index">
      <p class="section-kicker">En este artículo</p>
      <ol class="mt-4 space-y-1">
        {post.sections.map((section, index) => (
          <li>
            <a data-floating-index-link class="article-floating-link" href={`#${sectionId(section.heading, index)}`}>
              <span aria-hidden="true">0{index + 1}</span>
              <span>{section.heading}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </aside>
</div>
