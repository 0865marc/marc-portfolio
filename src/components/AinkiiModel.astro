---
import { professionalProfile } from '../data/portfolio'

interface Props {
  compact?: boolean
  showDecision?: boolean
}

const { compact = false, showDecision = true } = Astro.props
const ainkii = professionalProfile.projects.find(project => project.id === 'ainkii')!
---

<div class:list={['ainkii-model', compact && 'ainkii-model--compact']}>
  <div class="ainkii-copilot">
    <span aria-hidden="true">IA</span>
    <div>
      <strong>IA para revisar</strong>
      <p>Ordena y propone</p>
    </div>
  </div>
  <ol>
    {ainkii.model.map((level, index) => (
      <li>
        <span>{String(index + 1).padStart(2, '0')}</span>
        <strong>{level}</strong>
        {index < ainkii.model.length - 1 && <span class="ainkii-model-arrow" aria-hidden="true">↓</span>}
      </li>
    ))}
  </ol>
  {showDecision && (
    <div class="ainkii-human-gate">
      <span aria-hidden="true">✓</span>
      <p><strong>Revisión humana</strong><br />{ainkii.principle}</p>
    </div>
  )}
</div>
