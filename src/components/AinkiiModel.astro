---
import { professionalProfile } from '../data/portfolio'

interface Props {
  compact?: boolean
}

const { compact = false } = Astro.props
const ainkii = professionalProfile.projects.find(project => project.id === 'ainkii')!
---

<div class:list={['ainkii-model', compact && 'ainkii-model--compact']}>
  <div class="ainkii-copilot">
    <span aria-hidden="true">AI</span>
    <div>
      <strong>Copiloto editorial</strong>
      <p>Analiza, propone y revisa</p>
    </div>
  </div>
  <ol>
    {ainkii.model.map((level, index) => (
      <li>
        <span>{String(index + 1).padStart(2, '0')}</span>
        <strong>{level}</strong>
        {index < ainkii.model.length - 1 && <span class="ainkii-model-arrow" aria-hidden="true">↓</span>}
      </li>
    ))}
  </ol>
  <div class="ainkii-human-gate">
    <span aria-hidden="true">✓</span>
    <p><strong>Validación humana</strong><br />El usuario aprueba los cambios importantes</p>
  </div>
</div>
