---
import { professionalProfile } from '../data/portfolio'

const { identity, facts, experience, languages, education } = professionalProfile
---

<section id="about" aria-labelledby="about-title" class="scroll-mt-6 px-5 py-16 sm:px-8 md:px-10 md:py-24">
  <div class="mx-auto max-w-6xl">
    <div data-section-intro class="grid items-end gap-8">
      <div class="min-w-0">
        <p class="section-kicker">Sobre mí</p>
        <h2 id="about-title" data-route-heading tabindex="-1" class="mt-4 text-4xl font-black uppercase leading-tight sm:text-5xl">Experiencia</h2>
      </div>
      <p data-section-intro-copy class="min-w-0 max-w-3xl text-xl font-light leading-relaxed opacity-80">{identity.aboutIntro}</p>
    </div>

    <p data-education class="mt-6 max-w-3xl font-light leading-relaxed opacity-75">{education.qualification} · {education.institution}, {education.startYear}–{education.endYear}.</p>

    <dl class="profile-facts mx-auto mt-14 max-w-4xl">
      {facts.map((fact, index) => (
        <div data-reveal data-reveal-delay={String(index * 80)}>
          <dt>{fact.label}</dt>
          <dd class="profile-fact-value">{fact.value}</dd>
          <dd class="profile-fact-context">{fact.context}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-16 grid gap-8 lg:grid-cols-[1.25fr_.75fr]">
      <section aria-labelledby="experience-title">
        <p class="section-kicker">Experiencia</p>
        <h3 id="experience-title" class="mt-4 text-3xl font-medium uppercase sm:text-4xl">Trayectoria profesional</h3>
        <ol class="mt-8 divide-y divide-[#D7E2EA]/20 border-y border-[#D7E2EA]/20">
          {experience.map(entry => (
            <li class="grid gap-4 py-6 sm:grid-cols-[9rem_minmax(0,1fr)]">
              <p class="text-xs uppercase tracking-[.16em] opacity-60">{entry.period}</p>
              <div class="min-w-0">
                <p class="text-sm uppercase tracking-[.16em] opacity-60">{entry.company}</p>
                <h4 class="mt-2 text-xl font-medium uppercase leading-tight">{entry.role}</h4>
                <ul class="mt-3 space-y-3 font-light leading-relaxed opacity-80">
                  {entry.summary.split(/(?<=\.)\s+(?=[A-ZÁÉÍÓÚ])/).map(contribution => <li>{contribution}</li>)}
                </ul>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <div class="grid content-start gap-8">
        <section class="rounded-[28px] border border-[#D7E2EA]/20 p-6">
          <p class="section-kicker">Idiomas</p>
          <dl class="mt-4 space-y-4">
            {languages.map(language => (
              <div>
                <dt class="font-medium">{language.language} · {language.level}</dt>
                <dd class="mt-1 text-sm font-light opacity-70">{language.context}</dd>
              </div>
            ))}
          </dl>
        </section>
      </div>
    </div>
  </div>
</section>
