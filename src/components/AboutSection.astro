---
import { professionalProfile } from '../data/portfolio'

const { identity, facts, experience, education, languages } = professionalProfile
---

<section id="about" aria-labelledby="about-title" class="scroll-mt-6 px-5 py-24 sm:px-8 md:px-10 md:py-32">
  <div class="mx-auto max-w-6xl">
    <p class="section-kicker text-center">Perfil</p>
    <h2 id="about-title" data-route-heading tabindex="-1" class="hero-heading mt-5 text-center text-[clamp(3rem,12vw,9rem)] font-black uppercase leading-none">Sobre mí</h2>
    <p class="mx-auto mt-10 max-w-3xl text-center text-xl font-light leading-relaxed sm:text-2xl">{identity.summary}</p>
    <p class="mx-auto mt-5 max-w-3xl text-center font-light leading-relaxed opacity-70">{identity.narrative}</p>

    <dl class="profile-facts mt-14">
      {facts.map((fact, index) => (
        <div data-reveal data-reveal-delay={String(index * 80)}>
          <dt>{fact.label}</dt>
          <dd class="profile-fact-value">{fact.value}</dd>
          <dd class="profile-fact-context">{fact.context}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-24 flex items-end justify-between gap-6 border-b border-[#D7E2EA]/20 pb-5">
      <h3 id="experience-title" class="text-sm uppercase tracking-[.24em] opacity-60">Experiencia profesional</h3>
      <p class="hidden text-sm font-light opacity-60 sm:block">De construir la plataforma a coordinar el ecosistema.</p>
    </div>

    <div aria-labelledby="experience-title">
      {experience.map((entry, index) => (
        <article data-reveal data-reveal-delay={String(index * 90)} class="experience-card border-b border-[#D7E2EA]/20 py-12">
          <header class="grid gap-6 lg:grid-cols-[11rem_minmax(15rem,.75fr)_1.25fr] lg:gap-10">
            <div>
              <p class="text-xs uppercase tracking-[.2em] opacity-60">{entry.period}</p>
              <p class="mt-3 text-sm font-light opacity-65">{entry.location}{entry.workMode ? ` · ${entry.workMode}` : ''}</p>
            </div>
            <div>
              <p class="text-sm uppercase tracking-[.18em] opacity-60">{entry.company}</p>
              <h4 class="mt-3 text-2xl font-medium uppercase leading-tight">{entry.role}</h4>
            </div>
            <p class="text-lg font-light leading-relaxed opacity-80">{entry.summary}</p>
          </header>

          <div class="experience-sections mt-9">
            {entry.publicSections.map(section => (
              <section>
                <h5>{section.title}</h5>
                <ul>{section.items.map(item => <li>{item}</li>)}</ul>
              </section>
            ))}
            {entry.appliedAI.length > 0 && (
              <section class="experience-ai-section">
                <h5>IA y automatización aplicada</h5>
                <div class="grid gap-4 sm:grid-cols-3">
                  {entry.appliedAI.map(use => (
                    <article>
                      <h6>{use.title}</h6>
                      <p>{use.description}</p>
                    </article>
                  ))}
                </div>
              </section>
            )}
          </div>

          <ul aria-label={`Tecnologías utilizadas en ${entry.company}`} class="mt-7 flex flex-wrap gap-2">
            {entry.technologies.map(item => <li class="tag-dark">{item}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <div class="profile-foundations mt-20">
      <section data-reveal>
        <p class="section-kicker">Formación</p>
        <h3>{education.qualification}</h3>
        <p class="profile-foundation-meta">{education.institution} · {education.startYear}–{education.endYear}</p>
        <p>{education.context}</p>
      </section>
      <section data-reveal data-reveal-delay="90">
        <p class="section-kicker">Idiomas</p>
        <h3>Comunicación local e internacional</h3>
        <dl class="mt-6 space-y-5">
          {languages.map(language => (
            <div>
              <dt>{language.language} · {language.level}</dt>
              <dd>{language.context}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>
  </div>
</section>
