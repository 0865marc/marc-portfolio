---
import { learningCourses, conceptCourseHref } from '../../data/learningCourses'
export function getStaticPaths() {
  return learningCourses.filter(course => course.available).flatMap(course => course.concepts.map(id => ({ params: { id } })))
}
// Preserve earlier concept URLs while making the course page the only reading surface.
const destination = conceptCourseHref(Astro.params.id!)
return Astro.redirect(destination, 301)
---
