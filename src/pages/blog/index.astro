---
import BaseLayout from '../../layouts/BaseLayout.astro'
import BlogFilters from '../../components/BlogFilters.astro'
import { blogPosts } from '../../data/blog'
---

<BaseLayout
  title="Blog de Marc Teixidó — Ingeniería de software e IA aplicada"
  description="Artículos publicados sobre ingeniería de software, automatización, herramientas y aprendizaje técnico."
  canonicalPath="/blog/"
>
  <main class="min-h-screen px-5 py-8 sm:px-8 md:px-10 md:py-10">
    <div class="mx-auto max-w-6xl">
      <a class="control" href="/">Volver al portfolio <span aria-hidden="true">↖</span></a>
      <header class="mt-16 grid items-end gap-8 lg:grid-cols-[1fr_26rem]">
        <div>
          <p class="section-kicker">Blog · {blogPosts.length} {blogPosts.length === 1 ? 'artículo publicado' : 'artículos publicados'}</p>
          <h1 data-route-heading tabindex="-1" class="mt-5 text-[clamp(3.5rem,10vw,6.5rem)] font-black uppercase leading-[.9]">Blog</h1>
        </div>
        <p class="text-xl font-light leading-relaxed opacity-70">Notas técnicas sobre prácticas de software, automatización y aprendizaje aplicado, publicadas como contexto complementario al portfolio.</p>
      </header>
      <BlogFilters />
    </div>
  </main>
</BaseLayout>
