---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Article from '../../components/Article.astro'
import { blogPosts, type BlogPost } from '../../data/blog'
import { professionalProfile } from '../../data/portfolio'

export function getStaticPaths() {
  return blogPosts.map(post => ({ params: { id: post.id }, props: { post } }))
}

interface Props {
  post: BlogPost
}

const { post } = Astro.props
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.publishedAt,
  dateModified: post.publishedAt,
  inLanguage: 'es',
  mainEntityOfPage: new URL(`/blog/${post.id}/`, Astro.site).href,
  author: {
    '@type': 'Person',
    name: professionalProfile.identity.fullName,
    url: new URL('/', Astro.site).href,
  },
}
---

{post && (
  <BaseLayout
    title={`${post.title} — Marc Teixidó`}
    description={post.excerpt}
    canonicalPath={`/blog/${post.id}/`}
    type="article"
    jsonLd={articleJsonLd}
  >
    <main class="min-h-screen px-5 py-8 sm:px-8 md:px-10 md:py-10">
      <div class="article-back-layout mx-auto mb-8 max-w-6xl">
        <div class="mx-auto w-full max-w-3xl">
          <a data-article-back class="control" href="/blog/">Volver al Blog <span aria-hidden="true">↖</span></a>
        </div>
      </div>
      <Article post={post} />
    </main>
  </BaseLayout>
)}
