---
import BaseLayout from '../../layouts/BaseLayout.astro'
import AinkiiModel from '../../components/AinkiiModel.astro'
import { professionalProfile } from '../../data/portfolio'

const ainkii = professionalProfile.projects.find(project => project.id === 'ainkii')!
const ainkiiJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: ainkii.canonicalName,
  description: ainkii.description,
  url: new URL('/proyectos/ainkii/', Astro.site).href,
  inLanguage: 'es',
  genre: 'Producto educativo AI-first',
  creator: {
    '@type': 'Person',
    name: professionalProfile.identity.fullName,
    url: new URL('/', Astro.site).href,
  },
  audience: {
    '@type': 'Audience',
    audienceType: ainkii.audience,
  },
}
---

<BaseLayout
  title="Ainkii — Producto educativo AI-first de Marc Teixidó"
  description="Ainkii ayuda a profesores y creadores a estructurar, revisar y mejorar materiales educativos con una IA que actúa como copiloto editorial y mantiene la validación humana."
  canonicalPath="/proyectos/ainkii/"
  imageAlt="Ainkii — Temarios, temas, conocimientos y tarjetas con IA y validación humana"
  jsonLd={ainkiiJsonLd}
>
  <main>
    <header class="px-5 pb-20 pt-8 sm:px-8 md:px-10 md:pb-28 md:pt-10">
      <div class="mx-auto max-w-6xl">
        <a class="control" href="/#projects">Volver a proyectos <span aria-hidden="true">↖</span></a>
        <div class="mt-16 grid items-end gap-10 lg:grid-cols-[minmax(0,1fr)_22rem]">
          <div>
            <div class="flex flex-wrap gap-3 text-xs uppercase tracking-[.2em] opacity-60">
              <span>Proyecto insignia</span><span aria-hidden="true">·</span><span>{ainkii.status}</span>
            </div>
            <h1 data-route-heading tabindex="-1" class="hero-heading mt-5 text-[clamp(4rem,14vw,10rem)] font-black uppercase leading-[.84]">Ainkii</h1>
            <p class="mt-8 max-w-4xl text-2xl font-light leading-relaxed sm:text-3xl">IA para ayudar a construir mejores materiales de aprendizaje, sin sacar al profesor del proceso.</p>
          </div>
          <aside class="border-l border-[#D7E2EA]/25 pl-6">
            <p class="text-xs uppercase tracking-[.2em] opacity-60">Para quién</p>
            <p class="mt-4 text-xl font-light leading-relaxed">{ainkii.audience}</p>
          </aside>
        </div>
      </div>
    </header>

    <section aria-labelledby="ainkii-purpose-title" class="surface-light rounded-t-[40px] bg-white px-5 py-24 text-[#0C0C0C] sm:px-8 md:px-10 md:py-32">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
          <div>
            <p class="section-kicker">El producto</p>
            <h2 id="ainkii-purpose-title" class="mt-5 text-[clamp(2.75rem,7vw,6rem)] font-black uppercase leading-[.92]">Estructura antes que generación</h2>
            <p class="mt-7 text-xl font-light leading-relaxed text-black/70">{ainkii.description}</p>
          </div>
          <AinkiiModel />
        </div>

        <section aria-labelledby="ainkii-capabilities-title" class="mt-24">
          <div class="grid gap-6 lg:grid-cols-[1fr_25rem] lg:items-end">
            <div>
              <p class="section-kicker">Copiloto editorial</p>
              <h2 id="ainkii-capabilities-title" class="mt-4 text-4xl font-medium uppercase sm:text-6xl">Qué puede aportar la IA</h2>
            </div>
            <p class="font-light leading-relaxed text-black/65">La plataforma acompaña la creación y la revisión. No convierte una propuesta automática en verdad por defecto.</p>
          </div>
          <ol class="ainkii-capabilities mt-12">
            {ainkii.capabilities.map((capability, index) => (
              <li data-reveal>
                <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <p>{capability}</p>
              </li>
            ))}
          </ol>
        </section>

        <section aria-labelledby="ainkii-principle-title" class="ainkii-principle mt-24">
          <div>
            <p class="section-kicker">Principio de producto</p>
            <h2 id="ainkii-principle-title">La decisión importante sigue siendo humana</h2>
          </div>
          <p>{ainkii.principle}</p>
        </section>
      </div>
    </section>

    <section aria-labelledby="ainkii-status-title" class="px-5 py-24 sm:px-8 md:px-10 md:py-32">
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1fr_25rem] lg:items-end">
        <div>
          <p class="section-kicker">Estado</p>
          <h2 id="ainkii-status-title" class="hero-heading mt-5 text-[clamp(3rem,9vw,7rem)] font-black uppercase leading-none">En desarrollo</h2>
          <p class="mt-7 max-w-3xl text-xl font-light leading-relaxed opacity-80">Estoy desarrollando Ainkii como producto educativo AI-first y está previsto hacerlo público próximamente. Hasta entonces, esta página explica el objetivo y los límites del producto sin anunciar una fecha o resultados que todavía no existen.</p>
        </div>
        <div class="flex flex-col gap-3">
          <a class="button-light" href={`mailto:${professionalProfile.contacts.email}`}>Hablar sobre Ainkii <span aria-hidden="true">↗</span></a>
          <a class="control" href="/#about">Conocer mi trayectoria</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
