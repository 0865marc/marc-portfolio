---
import BaseLayout from '../../layouts/BaseLayout.astro'
import AinkiiModel from '../../components/AinkiiModel.astro'
import ProjectBrand from '../../components/ProjectBrand.astro'
import { professionalProfile } from '../../data/portfolio'

const ainkii = professionalProfile.projects.find(project => project.id === 'ainkii')!
const ainkiiJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: ainkii.canonicalName,
  description: ainkii.description,
  url: new URL('/proyectos/ainkii/', Astro.site).href,
  sameAs: ainkii.website,
  image: new URL(ainkii.logo.src, Astro.site).href,
  inLanguage: 'es',
  genre: 'Producto educativo',
  creator: {
    '@type': 'Person',
    name: professionalProfile.identity.fullName,
    url: new URL('/', Astro.site).href,
  },
  audience: {
    '@type': 'Audience',
    audienceType: ainkii.audience,
  },
}
---

<BaseLayout
  title="Ainkii — Producto educativo en desarrollo | Marc Teixidó"
  description="Ainkii conecta temarios, tarjetas de práctica y seguimiento para alumnos y academias. Proyecto en desarrollo con landing pública; aplicación interna aún no abierta al público."
  canonicalPath="/proyectos/ainkii/"
  imageAlt="Ainkii — proyecto educativo en desarrollo para organizar materiales de aprendizaje"
  jsonLd={ainkiiJsonLd}
>
  <main>
    <header class="px-5 pb-20 pt-8 sm:px-8 md:px-10 md:pb-28 md:pt-10">
      <div class="mx-auto max-w-6xl">
        <a class="control" href="/#projects">Volver a los proyectos <span aria-hidden="true">↖</span></a>
        <div class="mt-16 grid items-end gap-10 lg:grid-cols-[minmax(0,1fr)_22rem]">
          <div>
            <div class="flex flex-wrap gap-3 text-xs uppercase tracking-[.2em] opacity-60">
              <span>Proyecto personal</span><span aria-hidden="true">·</span><span>{ainkii.status}</span>
            </div>
            <h1 data-route-heading tabindex="-1" class="hero-heading mt-5 text-[clamp(4rem,14vw,10rem)] font-black uppercase leading-[.84]">Ainkii</h1>
            <p class="mt-8 max-w-4xl text-2xl font-light leading-relaxed sm:text-3xl">{ainkii.description}</p>
            <p class="mt-6 max-w-2xl font-light leading-relaxed opacity-75">{ainkii.availability}</p>
            <a class="button-light mt-6" href={ainkii.website}>{ainkii.websiteLabel} <span aria-hidden="true">↗</span></a>
          </div>
          <aside class="min-w-0">
            <ProjectBrand project={ainkii} />
            <p class="mt-6 text-xs uppercase tracking-[.2em] opacity-60">Para quién</p>
            <p class="mt-4 text-xl font-light leading-relaxed">{ainkii.audience}</p>
          </aside>
        </div>
      </div>
    </header>

    <section aria-labelledby="ainkii-purpose-title" class="surface-light rounded-t-[40px] bg-white px-5 py-24 text-[#0C0C0C] sm:px-8 md:px-10 md:py-32">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
          <div>
            <p class="section-kicker">Cómo se organiza</p>
            <h2 id="ainkii-purpose-title" class="mt-5 text-[clamp(2.75rem,7vw,6rem)] font-black uppercase leading-[.92]">Un temario conectado</h2>
            <p class="mt-7 text-xl font-light leading-relaxed text-black/70">La estructura parte del temario: cada tema reúne conocimientos relacionados y tarjetas para practicarlos. Los requisitos orientan el orden de lectura y conectan cada ejercicio con lo que se necesita comprender antes.</p>
          </div>
          <AinkiiModel />
        </div>

        <section aria-labelledby="ainkii-capabilities-title" class="mt-24">
          <div class="grid gap-6 lg:grid-cols-[1fr_25rem] lg:items-end">
            <div>
              <p class="section-kicker">Propuesta del producto</p>
              <h3 id="ainkii-capabilities-title" class="mt-4 text-4xl font-medium uppercase sm:text-6xl">De entender a practicar</h3>
            </div>
            <p class="font-light leading-relaxed text-black/65">La landing presenta este recorrido y permite explorar una demostración con datos de ejemplo. El acceso a la aplicación interna todavía no está disponible públicamente.</p>
          </div>
          <ol class="ainkii-capabilities mt-12">
            {ainkii.capabilities.map((capability, index) => (
              <li data-reveal>
                <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <p>{capability}</p>
              </li>
            ))}
          </ol>
        </section>

        <div class="mt-16 grid gap-10 border-t border-black/15 pt-10 md:grid-cols-2">
          <section aria-labelledby="ainkii-student-title">
            <p class="section-kicker">Para el alumno</p>
            <h3 id="ainkii-student-title" class="mt-4 text-3xl font-medium">Leer, practicar, volver a repasar</h3>
            <p class="mt-5 text-lg font-light leading-relaxed text-black/70">El recorrido propuesto empieza por leer un conocimiento y sus requisitos. Después se practican las tarjetas relacionadas. Las lecturas, la práctica y la precisión ayudan a reconocer el avance y los temas que necesitan más atención.</p>
          </section>
          <section aria-labelledby="ainkii-academy-title">
            <p class="section-kicker">Para la academia</p>
            <h3 id="ainkii-academy-title" class="mt-4 text-3xl font-medium">Preparar y acompañar</h3>
            <p class="mt-5 text-lg font-light leading-relaxed text-black/70">La propuesta reúne edición de contenidos, relaciones entre conocimientos, gestión de accesos y seguimiento por alumno y tema. La IA editorial prepara borradores y sugiere mejoras; un docente revisa cada propuesta antes de incorporarla al curso.</p>
          </section>
        </div>
      </div>
    </section>

    <section aria-labelledby="ainkii-status-title" class="px-5 py-24 sm:px-8 md:px-10 md:py-32">
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1fr_25rem] lg:items-end">
        <div>
          <p class="section-kicker">Estado</p>
          <h2 id="ainkii-status-title" class="hero-heading mt-5 text-[clamp(3rem,9vw,7rem)] font-black uppercase leading-none">Landing pública</h2>
          <p class="mt-7 max-w-3xl text-xl font-light leading-relaxed opacity-80">Ainkii está desplegado parcialmente: se puede visitar la presentación del producto y su demostración de ejemplo. La aplicación interna sigue en desarrollo y aún no tiene acceso público.</p>
        </div>
        <div class="ainkii-route-actions flex min-w-0 flex-col gap-3">
          <a class="button-light" href={`mailto:${professionalProfile.contacts.email}`}>Conversar sobre Ainkii <span aria-hidden="true">↗</span></a>
          <a class="control" href="/#about">Conocer mi trayectoria</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
