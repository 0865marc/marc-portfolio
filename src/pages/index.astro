---
import BaseLayout from '../layouts/BaseLayout.astro'
import AboutSection from '../components/AboutSection.astro'
import BlogSection from '../components/BlogSection.astro'
import CareerSprintSection from '../components/CareerSprintSection.astro'
import HeroSection from '../components/HeroSection.astro'
import ProjectsSection from '../components/ProjectsSection.astro'
import { professionalProfile } from '../data/portfolio'

const { identity, education, contacts } = professionalProfile
const canonicalUrl = new URL('/', Astro.site).href
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: identity.fullName,
  url: canonicalUrl,
  jobTitle: identity.headline,
  description: identity.summary,
  homeLocation: { '@type': 'Place', name: identity.location },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: education.institution,
  },
  sameAs: [contacts.linkedin],
}
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `Portfolio profesional de ${identity.fullName}`,
  url: canonicalUrl,
  inLanguage: 'es',
  author: { '@type': 'Person', name: identity.fullName },
}
---

<BaseLayout
  title={identity.seo.title}
  description={identity.seo.description}
  canonicalPath="/"
  imageAlt={identity.seo.imageAlt}
  jsonLd={[personJsonLd, websiteJsonLd]}
>
  <main>
    <HeroSection />
    <AboutSection />
    <ProjectsSection>
      <CareerSprintSection slot="career-sprint" />
      <div slot="notes" hidden><BlogSection /></div>
    </ProjectsSection>
  </main>
</BaseLayout>
