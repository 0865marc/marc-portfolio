---
import BaseLayout from '../layouts/BaseLayout.astro'
import AboutSection from '../components/AboutSection.astro'
import FormationSection from '../components/FormationSection.astro'
import HeroSection from '../components/HeroSection.astro'
import ProjectsSection from '../components/ProjectsSection.astro'
import { professionalProfile } from '../data/portfolio'

const { identity, education, contacts } = professionalProfile
const currentExperience = professionalProfile.experience.find(entry => entry.endDate === null)!
const canonicalUrl = new URL('/', Astro.site).href
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: identity.fullName,
  url: canonicalUrl,
  jobTitle: currentExperience.role,
  description: identity.summary,
  homeLocation: { '@type': 'Place', name: identity.location },
  worksFor: { '@type': 'Organization', name: currentExperience.company },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: education.institution,
  },
  sameAs: [contacts.linkedin],
}
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `Portfolio profesional de ${identity.fullName}`,
  url: canonicalUrl,
  inLanguage: 'es',
  author: { '@type': 'Person', name: identity.fullName },
}
---

<BaseLayout
  title={identity.seo.title}
  description={identity.seo.description}
  canonicalPath="/"
  imageAlt={identity.seo.imageAlt}
  jsonLd={[personJsonLd, websiteJsonLd]}
>
  <main>
    <HeroSection />
    <AboutSection />
    <ProjectsSection>
      <FormationSection slot="formation" />
    </ProjectsSection>
  </main>
</BaseLayout>
