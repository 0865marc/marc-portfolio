---
import '@fontsource/kanit/300.css'
import '@fontsource/kanit/400.css'
import '@fontsource/kanit/500.css'
import '@fontsource/kanit/900.css'
import '../index.css'
import { professionalProfile } from '../data/portfolio'

type JsonLd = Record<string, unknown>

interface Props {
  title: string
  description: string
  canonicalPath?: string | null
  type?: 'website' | 'article'
  imagePath?: string
  imageAlt?: string
  robots?: string
  jsonLd?: JsonLd | JsonLd[]
}

const {
  title,
  description,
  canonicalPath,
  type = 'website',
  imagePath = '/og-card.png',
  imageAlt = professionalProfile.identity.seo.imageAlt,
  robots = 'index,follow,max-image-preview:large',
  jsonLd = [],
} = Astro.props
const canonical = canonicalPath === null ? null : new URL(canonicalPath ?? Astro.url.pathname, Astro.site)
const socialImage = new URL(imagePath, Astro.site)
const jsonLdEntries = Array.isArray(jsonLd) ? jsonLd : [jsonLd]
const serializeJsonLd = (value: JsonLd) => JSON.stringify(value).replaceAll('<', '\\u003c')
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0C0C0C" />
    <meta name="author" content="Marc Teixidó Rosauro" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Marc Teixidó Rosauro" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <title>{title}</title>
    {jsonLdEntries.map(entry => <script is:inline type="application/ld+json" set:html={serializeJsonLd(entry)} />)}
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body><slot /><script src="../scripts/navigation.ts"></script><script src="../scripts/enhancements.ts"></script></body>
</html>
