{
  "name": "marc-portfolio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.16.0",
  "type": "module",
  "scripts": {
    "prepare:cms": "node scripts/prepare-cms.mjs",
    "predev": "npm run prepare:cms",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "prebuild": "npm run prepare:cms",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:static": "vitest run tests/static-output.test.ts",
    "test:e2e": "playwright test",
    "test:container": "bash scripts/verify-container-image.sh",
    "measure:assets": "node scripts/measure-route-assets.mjs",
    "benchmark:lighthouse": "node scripts/benchmark-lighthouse.mjs",
    "verify:agents": "python3 .agents/scripts/validate_design.py .agents/DESIGN.md && python3 -m unittest discover -s .agents/tests -p 'test_*.py' -v",
    "verify:cms-auth": "npm run verify:upstream --prefix ops/cms-auth",
    "verify": "npm run verify:agents && npm run verify:cms-auth && npm run check && npm run test:unit && npm run build && npm run test:static && npm run measure:assets"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "4.12.1",
    "@fontsource-variable/material-symbols-outlined": "5.3.1",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@fontsource/kanit": "5.3.0",
    "@fontsource/noto-mono": "5.3.0",
    "@playwright/test": "1.61.1",
    "@sveltia/cms": "0.196.0",
    "astro": "7.1.3",
    "autoprefixer": "10.5.4",
    "esbuild": "0.28.1",
    "lighthouse": "12.8.2",
    "postcss": "8.5.20",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
